# usrp-rc configuration. Copy to /etc/usrp-rc/usrp-rc.conf and edit for your site.
#
# Check your edits before restarting:  usrp-rc --check /etc/usrp-rc/usrp-rc.conf
# usrp-rc will not start with config errors. Each one is reported by line number.
#
# Format: "key = value", no quotes. # starts a comment. Any setting you leave
# out takes the default shown in the optional sections further down.

# Your callsign, letters and digits only. {call} in a message is replaced by it:
# sent as-is in CW, spelled out word by word in voice (W1XYZ = W ONE X Y Z).
callsign = W1XYZ

# cor or cor_ctcss. CTCSS decode is MMDVM-Host's job ([FM] CTCSSFrequency and
# AccessMode), so cor_ctcss currently behaves the same as cor.
#access_mode = cor

[link]
# Network USRP peer: rusrp, usrp-reflector, or ASL-compatible endpoint.
# Set enabled = false for a standalone local repeater with no link socket at all.
enabled     = true
remote_host = 127.0.0.1
remote_port = 41001
local_port  = 34002
codec       = pcm      # pcm or opus
#bind_address  = 0.0.0.0
#opus_bitrate  = 8000   # 4000 to 64000; used when codec = opus
#opus_frame_ms = 60     # 20, 40, or 60; used when codec = opus
#start_on      = true   # link state at startup; the DTMF link commands change it after that

[events]
# Which message plays for each occasion. Empty = play nothing.
# initial_ids, mandatory_ids and tail_messages rotate through a comma-separated list (max 8).
initial_ids     = default_voice
mandatory_ids   = default_cw
ct_link_on_message = yellow_jacket
ct_link_message    = bumble_bee
timeout_message = timeout_warn
#startup_message        =
#anxious_id             =
#impolite_id            =
#timeout_cancel_message =
#ct_link_off_message    =               # local courtesy tone while the link is off; empty = ct_link_on_message
#tail_messages          =               # see timers.tail_every; empty = none
#time_message           = time_readback  # replies to DTMF commands; empty = no reply
#stats_message          = stats_readback
#link_on_message        = link_on_reply
#link_off_message       = link_off_reply

[messages]
# Your own messages, by name, for use in [events] above.
#
# {call} works in voice and cw. Voice messages can also use these, each as its own
# word, spoken as of when the message plays: {time}, {ampm}, {greeting}, {day}, {date},
# {year}, {keyups_day}, {keyups_week}, {minutes_day}, {minutes_week}.
#
#     name = voice: THISIS {call} REPEATER     voice clips from vocab_8k/ or user_8k/
#                                              "_" pauses audio.voice_gap_ms, "_400" pauses 400 ms
#     name = cw: {call}/R                      Morse; spaces are real word gaps
#     name = tone: 660:50 495:50               FREQ:MS notes, played in order
#     name = tone: 500+700:100                 two frequencies together
#     name = tone: 1760:30 _30 1760:30         _MS is silence
#     name = tone: 1200:60@0.9                 @LEVEL overrides audio.tone_level for one note
#     name = voice: THISIS {call} | cw: {call} | joins parts into one message
#
# A ready-made tone catalog is always available by name -- see tones.conf, which
# lists each tone with its notes and what it sounds like. Define a message here
# with the same name to replace a catalog tone.
default_voice = voice: THISIS {call} REPEATER
default_cw    = cw: {call}/R

[schedule]
# Change [events] settings during a time window. They change back by themselves when
# the window closes, and a restart in the middle of one picks it back up.
#
#     name = DAYS HH:MM-HH:MM setting=value [setting=value ...]
#
# DAYS is sun..sat, daily, weekdays or weekends, or by the calendar: 2nd-tue (1st to 5th),
# 15th, last-day or dec-8, which repeats every year. Comma-separated, no spaces. A day that
# doesn't occur in a given month just doesn't match. Times are 24-hour on
# the system clock. The window includes its start minute, not its end minute; one that
# ends before it starts runs past midnight. If windows overlap, the later line wins. A
# list like mandatory_ids takes no spaces here. An empty value turns a setting off.
#
# On a list, = replaces it, += adds to it and -= removes from it, working from [events]
# down the file. Use += and -= where windows can overlap, so they don't cancel each other:
#
#     weekly  = wed 07:00-19:25 tail_messages+=net_tonight
#     meeting = 2nd-wed 07:00-19:25 tail_messages+=club_meeting
#     no_cw   = sat,sun 00:00-23:59 mandatory_ids-=default_cw
#
#net_reminder = wed 07:00-19:25 tail_messages=net_tonight
#net_running  = wed 19:30-20:30 ct_link_on_message=net_ct ct_link_off_message=net_ct

# ── Optional: everything below shows the defaults ─────────────────────────
#
# Uncomment a section header along with the settings you want to change.

#[log]
#level = info          # error, warn, info, or debug

#[mmdvm]
# Loopback link to MMDVM-Host's native FM Network protocol. usrp-rc takes the
# place of G4KLX's fmgateway here -- do NOT run fmgateway as well. Requires
# [FM] LinkMode=1, and in MMDVM-Host.ini the ports are the reverse of these:
#     [FM Network]
#     Enable=1
#     LocalPort=3810     <- must equal rpt_port
#     GatewayPort=4810   <- must equal local_port
#local_address = 127.0.0.1
#local_port    = 4810
#rpt_address   = 127.0.0.1
#rpt_port      = 3810

#[audio]
# master_gain is a final multiplier on ALL generated controller audio: set it
# once for your modulator's headroom, then balance sounds with the levels below.
#master_gain          = 1.0
#morse_wpm            = 20
#morse_pitch          = 700
#morse_level          = 0.9
#impolite_morse_level = 0.3    # CW level when IDing over an active QSO (ducking)
#voice_level          = 0.9
#tone_level           = 0.5    # tones without their own @LEVEL
#voice_gap_ms         = 150    # length of a bare "_" pause
#ste_delay_ms         = 0      # squelch tail elimination delay (0 = off)
#lead_trim_ms         = 0      # mute this much leading RX audio per transmission (0 = off)
#pre_message_ms       = 0      # dead air after PTT-on before CW/voice starts
#post_message_ms      = 0      # dead air after audio drains before PTT-off

#[timers]
# All in seconds.
#hang        = 2.5     # PTT holdoff after the courtesy tone
#ct_delay    = 0.5     # from RX loss to courtesy tone
#kerchunk    = 0.5     # minimum COR hold to respond (anti-kerchunk)
#timeout     = 180     # time-out timer (TOT) transmit cutoff
#id_interval = 600     # mandatory ID interval (FCC: at most 10 minutes)
#id_anxious  = 60      # sneak an anxious ID this far before the deadline
#tail_every  = 10      # play events.tail_messages every this many tails; 0 = off
#tail_min_interval = 0 # ... but at least this many seconds apart; 0 = no limit

#[stats]
# Where usage figures survive a restart. Empty = keep them in memory only.
#file = /var/local/usrp-rc/stats

#[dtmf]
# Over-the-air DTMF commands from the repeater receiver. Off by default.
#enabled         = false
#min_tone_ms     = 40     # a tone must hold this long to count as a digit
#max_tone_ms     = 5000   # a tone held longer discards the sequence
#interdigit_ms   = 4000   # a longer gap between digits discards what came before
#end_of_tx_ms    = 8000   # a longer gap from last digit to unkey discards the sequence
#mute_hang_ms    = 2000   # repeat audio stays muted this long after the last tone
#beep_hz         = 440    # plays during the mute; level is audio.tone_level
#beep_on_ms      = 100
#beep_off_ms     = 900
#pad_test_prefix = 5      # pad test: prefix, then digits to read back. Empty = off.
#time_code       = 39     # speak the time. Empty = off, likewise the codes below.
#stats_code      = 38     # speak usage over the last 24 hours (events.stats_message)
#link_on_code    = 72
#link_off_code   = 73
