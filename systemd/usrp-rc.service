[Unit]
Description=usrp-rc - Repeater Controller for MMDVM-Host
Documentation=https://github.com/n0mjs710/usrp-rc
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/usrp-rc /etc/usrp-rc/usrp-rc.conf
Restart=on-failure
RestartSec=5
TimeoutStartSec=10
TimeoutStopSec=5

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
# Usage statistics survive restarts in /var/lib/usrp-rc.
StateDirectory=usrp-rc
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
