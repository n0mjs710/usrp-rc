[Unit]
Description=usrp-rc - USRP Repeater Controller
Documentation=https://github.com/n0mjs710/usrp-rc
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/usrp-rc /etc/usrp-rc/usrp-rc.toml
Restart=on-failure
RestartSec=5
TimeoutStartSec=10
TimeoutStopSec=5

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
