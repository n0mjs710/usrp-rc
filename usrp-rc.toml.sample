# usrp-rc sample configuration.
# Copy to /etc/usrp-rc/usrp-rc.toml and edit for your site.
#
# NAME LIMIT: message names (the "X" in [messages.X]), voice clip names in
# a `clip` word list, and every place you reference a message name below
# (ct_message, initial_ids, etc.) are capped at 31 characters — these are
# short identifiers, not free text, and longer values are silently
# truncated. This does NOT apply to actual content like CW `text`.

# "cor" (default) — COR alone opens the repeater. USRP carries a single
# keyup bit, so "cor_ctcss" has no independent CTCSS source in this build;
# it is accepted for structural completeness but behaves like "cor".
access_mode = "cor"

[mmdvm]
# Loopback USRP link to MMDVMHost (FM analog mode, "remote gateway" protocol).
# usrp-rc binds local_port to receive from MMDVMHost and sends to rpt_address:rpt_port.
# Set MMDVMHost's USRP Local Port = rpt_port and Gateway/RPT Port = local_port.
local_address = "127.0.0.1"
local_port    = 34001
rpt_address   = "127.0.0.1"
rpt_port      = 32001

[link]
# Network USRP peer: rusrp, usrp-reflector, or ASL-compatible endpoint.
enabled       = true      # false = standalone local repeater, no link socket at all
remote_host   = "127.0.0.1"
remote_port   = 41001
local_port    = 34002
bind_address  = "0.0.0.0"
codec         = "pcm"     # "pcm" or "opus"
opus_bitrate  = 8000
opus_frame_ms = 60

[audio]
# Final multiplier on ALL generated controller audio (tones, CW, voice) —
# set this once for your site's modulator/deviation headroom, then use the
# levels below to balance sounds against each other within that range.
master_gain          = 1.0
morse_wpm            = 20
morse_pitch          = 700
morse_level          = 0.9
impolite_morse_level = 0.3   # CW level when IDing over an active QSO (ducking)
voice_level          = 0.9
voice_gap_ms         = 150   # default pause length for a bare "_" word in a voice clip list
ste_delay_ms         = 0     # squelch tail elimination delay (0 = disabled)
pre_message_ms       = 0     # dead air after PTT-on before CW/voice starts
post_message_ms      = 0     # dead air after audio drains before PTT-off

[timers]
hang        = 2.5     # s — hang time: PTT holdoff after CT
ct_delay    = 0.5     # s — delay from RX loss to courtesy tone
kerchunk    = 0.5     # s — minimum COR hold to respond (anti-kerchunk)
timeout     = 180.0   # s — time-out timer (TOT) transmit cutoff
id_interval = 600.0   # s — mandatory ID interval (FCC <= 10 min)
id_anxious  = 60.0    # s — sneak anxious ID this far before the mandatory deadline

[events]
startup_message        = ""
initial_ids            = ["default_voice"]
mandatory_ids          = ["default_cw"]
anxious_id             = ""
impolite_id            = ""
ct_message             = "yellow_jacket"
ct_link_message        = "bumble_bee"
timeout_message        = "timeout_warn"
timeout_cancel_message = ""

# Messages are a shared pool referenced by name from [events] above.

[messages.default_cw]
elements = [{type = "cw", text = "W1XYZ/R"}]

[messages.yellow_jacket]
elements = [
  {type = "tone", freq1 = 330.0, freq2 = 0.0, ms = 50, amp = 0.7},
  {type = "tone", freq1 = 495.0, freq2 = 0.0, ms = 50, amp = 0.7},
  {type = "tone", freq1 = 660.0, freq2 = 0.0, ms = 50, amp = 0.7},
]

[messages.bumble_bee]
elements = [
  {type = "tone", freq1 = 330.0, freq2 = 0.0, ms = 100, amp = 0.7},
  {type = "tone", freq1 = 495.0, freq2 = 0.0, ms = 100, amp = 0.7},
  {type = "tone", freq1 = 660.0, freq2 = 0.0, ms = 100, amp = 0.7},
]

[messages.timeout_warn]
elements = [
  {type = "tone", freq1 = 1200, freq2 = 0, ms = 60, amp = 0.9},
  {type = "tone", freq1 = 0,    freq2 = 0, ms = 20, amp = 0.0},
  {type = "tone", freq1 = 1000, freq2 = 0, ms = 60, amp = 0.9},
  {type = "tone", freq1 = 0,    freq2 = 0, ms = 20, amp = 0.0},
  {type = "tone", freq1 = 800,  freq2 = 0, ms = 60, amp = 0.9},
]

# A voice element's clip can be several clip names separated by spaces,
# played back to back — clip names themselves never contain spaces, so this
# is unambiguous. (CW `text` is NOT split this way — spaces there are real
# Morse word gaps.) Mix voice/cw/tone elements freely in one message.
#
# A word "_" inserts a pause instead of a clip: bare "_" uses voice_gap_ms
# above; "_NNN" (e.g. "_400") is an explicit NNN ms pause. Only recognized
# when '_' is followed solely by digits or nothing, so clip names like
# "_TEEN" are unaffected: {type = "voice", clip = "THIS IS _ W ONE REPEATER"}
[messages.default_voice]
elements = [{type = "voice", clip = "THIS IS W ONE X Y Z REPEATER"}]
