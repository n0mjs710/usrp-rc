  {type = "tone", freq1 = 0.0,    freq2 = 0.0, ms = 30, amp = 0.0},
  {type = "tone", freq1 = 1760.0, freq2 = 0.0, ms = 30, amp = 0.5},
  {type = "tone", freq1 = 0.0,    freq2 = 0.0, ms = 30, amp = 0.0},
